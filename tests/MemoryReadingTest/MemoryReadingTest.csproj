<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)'=='Debug' ">
    <OutputType>Exe</OutputType>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia"  Version="12.1.0"/>
    <PackageReference Include="Avalonia.Desktop"  Version="12.1.0"/>
    <PackageReference Include="Avalonia.Themes.Fluent"  Version="12.1.0"/>
    <PackageReference Include="Avalonia.Fonts.Inter"  Version="12.1.0"/>
    <!--Condition below keeps AvaloniaUI.DiagnosticsSupport out of Release builds.-->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'"  Version="2.2.3"/>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia"  Version="2.0.5"/>
    <PackageReference Include="NLog.Extensions.Logging"  Version="6.1.4"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\KeyAsio.Application\KeyAsio.Application.csproj" />
    <ProjectReference Include="..\..\src\Common\KeyAsio.Configuration\KeyAsio.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Core\KeyAsio.Sync\KeyAsio.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
